# NOTEBOOK 1: Build Sector Master and Maturity Allocation
# Cell 1: Imports and configuration

import sys
from pathlib import Path

sys.path.insert(0, str(Path.cwd().parent))

import pandas as pd
from src.io import load_xlsx, load_csv, save_csv
from src.preprocessing import load_and_merge_sector_data
from src.sector_model import (
    build_sector_master,
    build_maturity_allocation
)
from src.validation import (
    validate_sector_master,
    validate_maturity_allocation,
    print_validation_report
)

# ──────────────────────────────────────────────────────────────────────────────
# Cell 2: Load raw data

DATA_DIR = Path("../data/raw")

debt = load_xlsx(DATA_DIR / "sector_debt_clean.xlsx")
margins = load_xlsx(DATA_DIR / "sector_margins_clean.xlsx")
wacc = load_xlsx(DATA_DIR / "sector_wacc_clean.xlsx")
mapping = load_csv(DATA_DIR / "sector_mapping.csv")

print(f"Debt shape: {debt.shape}")
print(f"Margins shape: {margins.shape}")
print(f"WACC shape: {wacc.shape}")
print(f"Mapping shape: {mapping.shape}")

# ──────────────────────────────────────────────────────────────────────────────
# Cell 3: Build sector master

sector_master = build_sector_master(
    debt=debt,
    margins=margins,
    wacc=wacc,
    mapping=mapping,
    weight_col="Total_Debt_with_Leases_M"
)

print(f"\nSector Master:")
print(f"Shape: {sector_master.shape}")
print(f"Columns: {sector_master.columns.tolist()}")
print(f"\nData:\n{sector_master}")

# ──────────────────────────────────────────────────────────────────────────────
# Cell 4: Validate sector master

errors = validate_sector_master(sector_master)
if errors:
    print("❌ Validation FAILED:")
    for err in errors:
        print(f"  - {err}")
else:
    print("✓ Sector Master validation passed")

# ──────────────────────────────────────────────────────────────────────────────
# Cell 5: Save sector master

OUTPUT_DIR = Path("../data/processed")
OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

save_csv(sector_master, OUTPUT_DIR / "sector_master.csv")
print(f"Saved to {OUTPUT_DIR / 'sector_master.csv'}")

# ──────────────────────────────────────────────────────────────────────────────
# Cell 6: Build maturity allocation by year

maturity_allocation = build_maturity_allocation(
    sector_master=sector_master,
    years=(2026, 2027, 2028, 2029)
)

print(f"\nMaturity Allocation:")
print(f"Shape: {maturity_allocation.shape}")
print(f"\nData:\n{maturity_allocation}")

# ──────────────────────────────────────────────────────────────────────────────
# Cell 7: Validate allocation

errors = validate_maturity_allocation(maturity_allocation)
if errors:
    print("❌ Validation FAILED:")
    for err in errors:
        print(f"  - {err}")
else:
    print("✓ Maturity Allocation validation passed")

# ──────────────────────────────────────────────────────────────────────────────
# Cell 8: Save allocation

save_csv(
    maturity_allocation,
    OUTPUT_DIR / "sector_maturity_allocation_by_year.csv"
)
print(f"Saved to {OUTPUT_DIR / 'sector_maturity_allocation_by_year.csv'}")

# ──────────────────────────────────────────────────────────────────────────────
# Cell 9: Summary

print("\n" + "="*70)
print("NOTEBOOK 1 COMPLETE")
print("="*70)
print("\nOutputs:")
print(f"  ✓ sector_master.csv ({sector_master.shape[0]} sectors)")
print(f"  ✓ sector_maturity_allocation_by_year.csv ({maturity_allocation.shape[0]} sectors × 4 years)")
