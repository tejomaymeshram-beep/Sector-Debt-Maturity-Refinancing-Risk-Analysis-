# NOTEBOOK 3: Execute Stress Model and Generate Dashboard Inputs
# Cell 1: Imports and configuration

import sys
from pathlib import Path

sys.path.insert(0, str(Path.cwd().parent))

import pandas as pd
from src.io import load_csv, save_csv
from src.stress_model import (
    build_stress_model,
    build_stress_results,
    build_stress_summary,
    build_dashboard_input,
)
from src.dashboard_dataset import (
    export_dashboard_input,
    build_sector_summary_table,
    build_year_summary_table,
    build_refinancing_exposure_table,
    build_interest_impact_table,
)
from src.validation import (
    validate_stress_model_output,
    run_all_validations,
    print_validation_report,
)

# ──────────────────────────────────────────────────────────────────────────────
# Cell 2: Load dependencies

DATA_DIR = Path("../data/processed")

refinancing_baseline = load_csv(
    DATA_DIR / "sector_refinancing_baseline.csv"
)
credit_profile = load_csv(DATA_DIR / "sector_credit_profile.csv")
sector_master = load_csv(DATA_DIR / "sector_master.csv")

print("Dependencies loaded:")
print(f"  refinancing_baseline: {refinancing_baseline.shape}")
print(f"  credit_profile: {credit_profile.shape}")
print(f"  sector_master: {sector_master.shape}")

# ──────────────────────────────────────────────────────────────────────────────
# Cell 3: Load stress parameters

stress_parameters = pd.DataFrame({
    "Year": [2026, 2027, 2028, 2029],
    "Base_Rate_Shock_bp": [200, 300, 400, 500],
    "Credit_Spread_Shock_bp": [100, 150, 200, 250],
    "EBITDA_Shock_Pct": [-5, -10, -15, -20],
})

print(f"\nStress parameters:")
print(stress_parameters)

# Save stress parameter template for reference
save_csv(
    stress_parameters,
    DATA_DIR / "stress_parameter_template.csv"
)
print(f"Saved to {DATA_DIR / 'stress_parameter_template.csv'}")

# ──────────────────────────────────────────────────────────────────────────────
# Cell 4: Run stress model

print("\nRunning stress model...")

model_full = build_stress_model(
    refinancing_baseline=refinancing_baseline,
    credit_profile=credit_profile,
    sector_master=sector_master,
    stress_parameters=stress_parameters,
)

print(f"\nFull model shape: {model_full.shape}")
print(f"Columns: {model_full.columns.tolist()}")

# ──────────────────────────────────────────────────────────────────────────────
# Cell 5: Save full model

save_csv(model_full, DATA_DIR / "sector_stress_model.csv")
print(f"Saved to {DATA_DIR / 'sector_stress_model.csv'}")

# ──────────────────────────────────────────────────────────────────────────────
# Cell 6: Build and save stress results

stress_results = build_stress_results(model_full)
save_csv(stress_results, DATA_DIR / "sector_stress_results.csv")
print(f"Saved stress results to {DATA_DIR / 'sector_stress_results.csv'}")

# ──────────────────────────────────────────────────────────────────────────────
# Cell 7: Build and save stress summary

stress_summary = build_stress_summary(model_full)
save_csv(stress_summary, DATA_DIR / "sector_stress_summary.csv")
print(f"Saved stress summary to {DATA_DIR / 'sector_stress_summary.csv'}")

# ──────────────────────────────────────────────────────────────────────────────
# Cell 8: Build and save dashboard input

dashboard = build_dashboard_input(model_full)
save_csv(dashboard, DATA_DIR / "dashboard_input.csv")
print(f"Saved to {DATA_DIR / 'dashboard_input.csv'}")

# ──────────────────────────────────────────────────────────────────────────────
# Cell 9: Validate outputs

print("\n" + "="*70)
print("RUNNING VALIDATION SUITE")
print("="*70)

validation_results = run_all_validations(
    refinancing_baseline=refinancing_baseline,
    credit_profile=credit_profile,
    sector_master=sector_master,
    maturity_allocation=load_csv(
        DATA_DIR / "sector_maturity_allocation_by_year.csv"
    ),
    stress_model=model_full,
)

print_validation_report(validation_results)

# ──────────────────────────────────────────────────────────────────────────────
# Cell 10: Generate summary tables

sector_summary = build_sector_summary_table(model_full)
print(f"\nSector summary:")
print(sector_summary)

year_summary = build_year_summary_table(model_full)
print(f"\nYear summary:")
print(year_summary)

# ──────────────────────────────────────────────────────────────────────────────
# Cell 11: Export exposure and impact tables

refinancing_exposure = build_refinancing_exposure_table(model_full)
print(f"\nRefinancing exposure by sector/year:")
print(refinancing_exposure)

interest_impact = build_interest_impact_table(model_full)
print(f"\nInterest expense impact by sector/year:")
print(interest_impact)

# ──────────────────────────────────────────────────────────────────────────────
# Cell 12: Final summary

print("\n" + "="*70)
print("NOTEBOOK 3 COMPLETE")
print("="*70)
print("\nOutputs generated:")
print(f"  ✓ sector_stress_model.csv ({model_full.shape[0]} obs × {model_full.shape[1]} cols)")
print(f"  ✓ sector_stress_results.csv ({stress_results.shape[0]} obs)")
print(f"  ✓ sector_stress_summary.csv ({stress_summary.shape[0]} sectors)")
print(f"  ✓ dashboard_input.csv ({dashboard.shape[0]} obs)")
print(f"  ✓ stress_parameter_template.csv (4 years)")
print("\nAll files saved to ../data/processed/")
