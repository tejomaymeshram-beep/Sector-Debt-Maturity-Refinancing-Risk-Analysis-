# NOTEBOOK 2: Build Credit Profile and Refinancing Baseline
# Cell 1: Imports and configuration

import sys
from pathlib import Path

sys.path.insert(0, str(Path.cwd().parent))

import pandas as pd
from src.io import load_csv, load_xlsx, save_csv
from src.credit_model import (
    calculate_default_spread,
    assign_synthetic_ratings,
    add_rating_scores,
    build_threshold_profile,
    build_refinancing_baseline,
)
from src.validation import (
    validate_credit_profile,
    validate_sector_refinancing_baseline,
    print_validation_report,
)

# ──────────────────────────────────────────────────────────────────────────────
# Cell 2: Load dependencies

DATA_DIR = Path("../data/processed")
RAW_DIR = Path("../data/raw")

sector_master = load_csv(DATA_DIR / "sector_master.csv")
maturity_allocation = load_csv(
    DATA_DIR / "sector_maturity_allocation_by_year.csv"
)
rating_lookup = load_xlsx(RAW_DIR / "synthetic_rating_lookup.xlsx")
maturity_wall = load_csv(RAW_DIR / "regional_maturity_wall.csv")

print("Dependencies loaded:")
print(f"  sector_master: {sector_master.shape}")
print(f"  maturity_allocation: {maturity_allocation.shape}")
print(f"  rating_lookup: {rating_lookup.shape}")
print(f"  maturity_wall: {maturity_wall.shape}")

# ──────────────────────────────────────────────────────────────────────────────
# Cell 3: Calculate default spreads

RISK_FREE_RATE = 0.0395

credit = calculate_default_spread(
    sector_master=sector_master,
    risk_free_rate=RISK_FREE_RATE,
)

print(f"\nDefault spreads calculated:")
print(credit)

# ──────────────────────────────────────────────────────────────────────────────
# Cell 4: Assign synthetic ratings

credit = assign_synthetic_ratings(
    credit=credit,
    rating_lookup=rating_lookup,
)

print(f"\nSynthetic ratings assigned:")
print(credit)

# ──────────────────────────────────────────────────────────────────────────────
# Cell 5: Add rating scores

RATING_SCORE_MAP = {
    "Aaa/AAA": 15,
    "Aa2/AA": 14,
    "A1/A+": 13,
    "A2/A": 12,
    "A3/A-": 11,
    "Baa2/BBB": 10,
    "Ba1/BB+": 9,
    "Ba2/BB": 8,
    "B1/B+": 7,
    "B2/B": 6,
    "B3/B-": 5,
    "Caa/CCC": 4,
    "Ca2/CC": 3,
    "C2/C": 2,
    "D2/D": 1,
}

credit = add_rating_scores(
    credit=credit,
    rating_score_map=RATING_SCORE_MAP,
)

print(f"\nCredit profile with rating scores:")
print(credit)

# ──────────────────────────────────────────────────────────────────────────────
# Cell 6: Validate credit profile

errors = validate_credit_profile(credit)
if errors:
    print("❌ Validation FAILED:")
    for err in errors:
        print(f"  - {err}")
else:
    print("✓ Credit profile validation passed")

# ──────────────────────────────────────────────────────────────────────────────
# Cell 7: Save credit profile

save_csv(credit, DATA_DIR / "sector_credit_profile.csv")
print(f"Saved to {DATA_DIR / 'sector_credit_profile.csv'}")

# ──────────────────────────────────────────────────────────────────────────────
# Cell 8: Build threshold profile

threshold = build_threshold_profile(
    credit=credit,
)

print(f"\nThreshold profile:")
print(threshold)

# ──────────────────────────────────────────────────────────────────────────────
# Cell 9: Save threshold profile

save_csv(threshold, DATA_DIR / "sector_threshold_profile.csv")
print(f"Saved to {DATA_DIR / 'sector_threshold_profile.csv'}")

# ──────────────────────────────────────────────────────────────────────────────
# Cell 10: Build refinancing baseline

refi_baseline = build_refinancing_baseline(
    allocation=maturity_allocation,
    maturity_wall=maturity_wall,
    credit_profile=credit,
)

print(f"\nRefinancing baseline:")
print(f"Shape: {refi_baseline.shape}")
print(f"\nData:\n{refi_baseline.head(20)}")

# ──────────────────────────────────────────────────────────────────────────────
# Cell 11: Validate refinancing baseline

errors = validate_sector_refinancing_baseline(refi_baseline)
if errors:
    print("❌ Validation FAILED:")
    for err in errors:
        print(f"  - {err}")
else:
    print("✓ Refinancing baseline validation passed")

# ──────────────────────────────────────────────────────────────────────────────
# Cell 12: Save refinancing baseline

save_csv(refi_baseline, DATA_DIR / "sector_refinancing_baseline.csv")
print(f"Saved to {DATA_DIR / 'sector_refinancing_baseline.csv'}")

# ──────────────────────────────────────────────────────────────────────────────
# Cell 13: Summary

print("\n" + "="*70)
print("NOTEBOOK 2 COMPLETE")
print("="*70)
print("\nOutputs:")
print(f"  ✓ sector_credit_profile.csv ({credit.shape[0]} sectors)")
print(f"  ✓ sector_threshold_profile.csv ({threshold.shape[0]} sectors)")
print(f"  ✓ sector_refinancing_baseline.csv ({refi_baseline.shape[0]} observations)")
